<Window x:Class="RussianMilkApp.AddBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавление партии" Height="390" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Text="Новая партия продукции"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Продукт:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="ProductComboBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Склад:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="WarehouseComboBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Дата производства:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker x:Name="ProductionDatePicker" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Годен до:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker x:Name="ExpirationDatePicker" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="QuantityTextBox" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                   Text="Подсказка: выбери продукт, склад, даты и количество единиц в партии."
                   Foreground="#666"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Width="120" Height="34" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="120" Height="34" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
